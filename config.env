# Kafka
KAFKA_IMAGE=confluentinc/cp-kafka:latest
KAFKA_CONTAINER=kafka-container
EXTERNAL_PORT=9092

# Redis
REDIS_IMAGE=redis:7.2-alpine
REDIS_CONTAINER=redis-standalone
REDIS_PORT=6379

# ClickHouse
CLICKHOUSE_IMAGE=clickhouse/clickhouse-server:latest
CLICKHOUSE_CONTAINER_NAME=clickhouse-server
CLICKHOUSE_HTTP_PORT=8123
CLICKHOUSE_NATIVE_PORT=9000
CLICKHOUSE_USER=admin

# HackerNews
HACKERNEWS_LOADER_IMAGE=python:3.9-slim
HACKERNEWS_LOADER_CONTAINER_NAME=hackernews-loader
HACKERNEWS_LOAD_LIMIT=100
HACKERNEWS_TOP_STORIES_URL=https://hacker-news.firebaseio.com
HACKERNEWS_ITEM_BASE_URL=https://hacker-news.firebaseio.com

# Qdrant
QDRANT_IMAGE=qdrant/qdrant:latest
QDRANT_CONTAINER_NAME=qdrant-vector-db
QDRANT_PORT=6333
QDRANT_GRPC_PORT=6334
